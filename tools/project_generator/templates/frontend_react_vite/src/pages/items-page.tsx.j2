{% if config.has_backend %}
import { useEffect, useState } from 'react';

import { Card } from '../components/ui/card';
import { ApiError } from '../lib/http/api-error';
import { listItems } from '../features/items/items-service';
import type { Item } from '../features/items/items-types';

export function ItemsPage() {
  const [items, setItems] = useState<Item[]>([]);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let active = true;
    listItems()
      .then((data) => {
        if (active) setItems(data);
      })
      .catch((caught: unknown) => {
        if (active) setError(caught instanceof ApiError ? caught.message : 'Unable to load items.');
      });
    return () => {
      active = false;
    };
  }, []);

  return (
    <main className="page-shell stack">
      <h1>Items</h1>
      {error ? <p className="error">{error}</p> : null}
      <div className="card-grid">
        {items.map((item) => (
          <Card key={item.id}>
            <h2>{item.title}</h2>
            <p>{item.description ?? 'No description provided.'}</p>
          </Card>
        ))}
        {!items.length && !error ? <p className="muted">No items yet.</p> : null}
      </div>
    </main>
  );
}
{% else %}
import { Card } from '../components/ui/card';

export function ItemsPage() {
  return (
    <main className="page-shell stack">
      <h1>Items</h1>
      <Card>
        <p>This frontend-only project is ready for a future API integration.</p>
      </Card>
    </main>
  );
}
{% endif %}
