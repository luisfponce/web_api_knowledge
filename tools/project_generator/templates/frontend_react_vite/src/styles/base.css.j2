:root {
  color: #172033;
  background: #f6f1e8;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.5;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

a {
  color: inherit;
}

.page-shell {
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
  padding: 64px 0;
}

.stack {
  display: grid;
  gap: 16px;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
  gap: 32px;
  align-items: center;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(2.5rem, 8vw, 5.75rem);
  line-height: 0.95;
  letter-spacing: -0.07em;
}

.lede {
  max-width: 680px;
  font-size: 1.25rem;
}

.eyebrow,
.muted {
  color: #667085;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 0.75rem;
  font-weight: 700;
}

.button {
  border: 0;
  border-radius: 999px;
  cursor: pointer;
  font-weight: 700;
  padding: 12px 20px;
}

.button-primary {
  background: #172033;
  color: #fffaf0;
}

.button-secondary {
  background: #e6ddce;
  color: #172033;
}

.card {
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(23, 32, 51, 0.1);
  border-radius: 24px;
  box-shadow: 0 24px 80px rgba(23, 32, 51, 0.08);
  padding: 24px;
}

.metric-card strong {
  font-size: 1.1rem;
}

.input {
  border: 1px solid #ccd3df;
  border-radius: 12px;
  font: inherit;
  padding: 10px 12px;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}

.error {
  color: #b42318;
}

@media (max-width: 760px) {
  .hero-grid {
    grid-template-columns: 1fr;
  }
}
