# Copy to .env for local development. Keep real secrets out of Git.
PROJECT_NAME={{ config.slug }}
ENVIRONMENT=local

{% if config.has_backend %}
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
{% if config.has_database %}
DATABASE_URL={{ config.database_url_placeholder }}
{% endif %}
{% if config.backend_options.auth %}
JWT_SECRET_KEY=change-this-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
{% endif %}
{% endif %}
{% if config.has_frontend %}
FRONTEND_PORT=8080
VITE_API_BASE_URL=/api/v1
{% endif %}
{% if config.has_persistent_database %}
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me
DB_PORT={% if config.database.value == "postgresql" %}5432{% else %}3306{% endif %}
{% endif %}
{% if config.infra.redis %}
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
{% endif %}
